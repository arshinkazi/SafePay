# SafePay backend — environment variables
# Copy this file to `.env` for local development (python-dotenv loads it
# automatically if present) or set these in your host's dashboard (Render:
# Environment tab). Never commit a real `.env` file.

# ── Required in production ───────────────────────────────────────────────────
# Long random secret used to sign JWTs. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# If unset, the app falls back to a built-in demo secret and logs a warning —
# fine for local dev, NOT fine for a real deployment.
JWT_SECRET_KEY=replace-with-a-long-random-secret

# Your deployed frontend origin(s), comma-separated if you have more than one
# (e.g. a Vercel production URL and a preview URL). Locks CORS down instead of
# allowing "*". Local dev origins (localhost:3000/5173/8080) are always
# allowed in addition to this, so you don't need to list them here.
FRONTEND_URL=https://your-frontend.vercel.app

# ── Optional: Razorpay (payment gateway) ─────────────────────────────────────
# Leave unset to run in demo mode — /create-order will generate a fake
# "order_DEMO_..." order and the frontend simulates the payment locally.
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# ── Optional: outbound OTP email via SMTP ────────────────────────────────────
# Leave unset to run in demo mode — the OTP is logged and also returned in the
# API response body so the demo UI can show it without a real inbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@safepay.demo

# ── Optional: infrastructure ──────────────────────────────────────────────────
# Where SQLite stores its file. Defaults to backend/safepay.db — only set this
# if you're pointing at a mounted persistent disk.
DATABASE_PATH=

# Port the dev server binds to (Render sets PORT itself; this is only read by
# `python app.py`, not by Gunicorn).
PORT=5000

# Set to "true" to enable Flask's debug mode for local development only.
# Never enable this in production.
FLASK_DEBUG=false

# Set to "false" to disable the local safepay.log file handler (stdout logging
# always stays on regardless of this setting).
LOG_TO_FILE=true
